    given-names: Hay
    email: yahbeaumont@gmail.com
    website: "https://github.com/yahbeaumont"
version: 0.1.0
date-released: "2026-11-24"
license: MIT
repository-code: "https://github.com/yahbeaumont/nanorouter"
keywords:
  - small language models
  - fine-tuning
  - lora
  - structured output
  - json schema
  - tool calling
  - intent routing
